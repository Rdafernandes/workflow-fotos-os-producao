    {
      "parameters": {
        "jsCode": "const job = $('Code | Extrair Stale Jobs').item.json;\n\nreturn [{\n  json: {\n    ...job,\n\n    reconcile_action: 'manual_review',\n    reconcile_reason: 'drive_inspection_error',\n\n    drive_snapshot: {\n      id: job.drive_file_id ?? null,\n      name: null,\n      parents: [],\n      trashed: null,\n      inspection_error: $json\n    },\n\n    drive_in_source: false,\n    drive_in_target: false,\n    drive_name_correct: false\n  }\n}];"
