              "leftValue": "={{ $json.reconcile_action }}",
              "rightValue": "mark_error_retry",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
