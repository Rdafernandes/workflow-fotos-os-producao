      "name": "Supabase | Stale Processing"
    },
    {
      "parameters": {
        "jsCode": "const jobs = Array.isArray($json.jobs) ? $json.jobs : [];\n\nreturn jobs.map(job => ({\n  json: job\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "name": "Code | Extrair Stale Jobs"
    },
    {
      "parameters": {
        "url": "=https://www.googleapis.com/drive/v3/files/{{$json.drive_file_id}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,name,parents,trashed"
            },
            {
              "name": "supportsAllDrives",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        672,
        0
      ],
      "name": "Google Drive | Inspecionar Arquivo",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const drive = $json;\nconst job = $('Code | Extrair Stale Jobs').item.json;\n\nconst parents = Array.isArray(drive.parents)\n  ? drive.parents.filter(Boolean)\n  : [];\n\nconst inSource = parents.includes(job.source_folder_id);\nconst inTarget = parents.includes(job.target_folder_id);\nconst trashed = drive.trashed === true;\nconst nameCorrect = drive.name === job.target_filename;\n\nlet reconcile_action;\nlet reconcile_reason;\n\nif (trashed) {\n  reconcile_action = 'manual_review';\n  reconcile_reason = 'file_trashed';\n} else if (parents.length !== 1) {\n  reconcile_action = 'manual_review';\n  reconcile_reason = 'unexpected_parent_count';\n} else if (inTarget && !inSource) {\n  if (nameCorrect) {\n    reconcile_action = 'mark_done';\n    reconcile_reason = 'file_already_in_target_with_correct_name';\n  } else {\n    reconcile_action = 'rename_only_then_mark_done';\n    reconcile_reason = 'file_already_in_target_with_wrong_name';\n  }\n} else if (inSource && !inTarget) {\n  reconcile_action = 'mark_error_retry';\n  reconcile_reason = 'file_still_in_source';\n} else {\n  reconcile_action = 'manual_review';\n  reconcile_reason = 'unexpected_parent';\n}\n\nreturn [{\n  json: {\n    ...job,\n\n    reconcile_action,\n    reconcile_reason,\n\n    drive_snapshot: {\n      id: drive.id ?? null,\n      name: drive.name ?? null,\n      parents,\n      trashed\n    },\n\n    drive_in_source: inSource,\n    drive_in_target: inTarget,\n    drive_name_correct: nameCorrect\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        -128
      ],
      "name": "Code | Classificar Estado Drive"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
